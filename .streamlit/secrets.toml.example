# Copia únicamente los valores que falten a los Secrets de Streamlit.
# NO reemplaces contraseñas o claves reales por estos ejemplos.
DB_HOST = "tu-endpoint.rds.amazonaws.com"
DB_NAME = "petskin_db"
DB_USER = "petskin_app"
DB_PASSWORD = "tu-contraseña-actual"
DB_PORT = 5432
AWS_ACCESS_KEY_ID = "tu-clave-actual"
AWS_SECRET_ACCESS_KEY = "tu-secreto-actual"
AWS_BUCKET_NAME = "tu-bucket-actual"
AWS_REGION = "us-east-2"
OPENAI_API_KEY = "tu-api-key-actual"

# Número del veterinario en formato internacional (código de país y número).
WHATSAPP_PHONE = ""
VISION_MODEL = "gpt-4o-mini"
CHAT_MODEL = "gpt-4o-mini"
# Opcional en otra región: archivo de CA RDS correspondiente, incluido en el repositorio.
# DB_SSLROOTCERT = "certs/us-east-2-bundle.pem"
